APP_NAME="Lyceum Appointments"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.gr
APP_TIMEZONE=Europe/Athens

APP_LOCALE=el
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# On Plesk, create the database and a dedicated DB user first (see
# docs/DEPLOYMENT.md), then fill in the values below. Never commit real
# credentials — this file is a template only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Database-backed sessions/cache/queue deliberately avoid requiring Redis
# or a persistent worker process, so this deploys on conventional shared
# hosting. QUEUE_CONNECTION=sync means jobs run inline — fine at this
# app's scale; switch to "database" + a scheduled `queue:work` only if
# email volume later requires it.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# Core functionality (booking, cancellation, imports) works with no mail
# driver configured — MAIL_MAILER=log simply writes emails to the log
# instead of sending them. Fill in real SMTP details when the school
# provides them for invitation/confirmation emails.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.gr"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
